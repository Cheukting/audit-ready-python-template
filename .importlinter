[importlinter]
root_package = mypackage
include_external_packages = True

[importlinter:contract:layers]
name = mypackage is layered
type = layers
containers = mypackage
# Every module in mypackage must be given a layer, so a new module fails CI
# until a human decides where it belongs.
exhaustive = true
layers =
    __main__
    cli
    client
    retry | clock
    config
    errors

[importlinter:contract:errors-is-a-leaf]
name = errors imports nothing from the package
type = forbidden
source_modules = mypackage.errors
# Note: `forbidden_modules = mypackage` (the root package) is silently a no-op,
# because import-linter will not forbid a source module's own ancestor. Forbid the
# children instead: the wildcard skips mypackage.errors itself and covers new modules.
forbidden_modules = mypackage.*

[importlinter:contract:only-client-does-http]
name = only client and retry talk to requests
type = forbidden
# Forbid every module, then allow-list the two that may talk to requests, so a new
# module is covered automatically.
source_modules = mypackage.*
forbidden_modules = requests
allow_indirect_imports = True
ignore_imports =
    mypackage.client -> requests
    mypackage.retry -> requests
